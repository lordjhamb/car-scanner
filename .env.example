# Copy to .env (or export) and adjust. All optional in development.
CARSCAN_ENV=development            # development | production
CARSCAN_DATA_DIR=data              # SQLite database, uploads, generated dev secret
# Required in production: a long random string. Encrypts users' AI API keys at rest.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
CARSCAN_SECRET_KEY=
CARSCAN_SECURE_COOKIES=false       # true when served over HTTPS
CARSCAN_HOST=127.0.0.1
CARSCAN_PORT=8077
CARSCAN_ALLOW_REGISTRATION=true
CARSCAN_SESSION_DAYS=30
CARSCAN_MAX_UPLOAD_MB=15
CARSCAN_CLAUDE_MODEL=claude-opus-5-5
CARSCAN_OPENAI_MODEL=gpt-5
